#!/bin/sh
# Uma conversa: roda a IA dela (HIVE_IA: claude, o padrão, ou codex) no pane
# atual. Quando ela sai, outra conversa assume a área principal; se era a
# última, a interface fecha.

n=$(tmux show -qv @proxima)
n=${n:-1}
tmux set -q @proxima $((n + 1))
tmux set -p -t "$TMUX_PANE" @conversa "$n"
ia=${HIVE_IA:-claude}
# No Codex, começa sem título (antes de marcar a IA, para o sidebar não tomar
# o título padrão do pane pelo nome da conversa): o que ele escrever nele é
# o nome dela.
[ "$ia" = codex ] && printf '\033]2;\033\\'
tmux set -p -t "$TMUX_PANE" @ia "$ia"
# O modelo escolhido no cabeçalho vale só para esta conversa.
if [ -n "$HIVE_MODELO" ]; then
	set -- --model "$HIVE_MODELO" "$@"
	tmux set -p -t "$TMUX_PANE" @modelo "$HIVE_MODELO"
else
	# Também identifica o modelo recebido na chamada inicial: hive --model …
	proximo_modelo=0
	for argumento do
		if [ "$proximo_modelo" = 1 ]; then
			tmux set -p -t "$TMUX_PANE" @modelo "$argumento"
			proximo_modelo=0
		fi
		case $argumento in
			--model | -m) proximo_modelo=1 ;;
			--model=*) tmux set -p -t "$TMUX_PANE" @modelo "${argumento#--model=}" ;;
		esac
	done
fi

# Hooks marcam título e status da conversa para o sidebar. No Codex, vão por
# -c (ver sidebar/codex.js), um por linha; o título do terminal fica só com o
# nome que ele dá à conversa (ver topico em sidebar/conversas.js), e o
# --no-daemon o mantém neste processo, com o ambiente deste pane (TMUX_PANE)
# para os hooks.
if [ "$ia" = codex ]; then
	while IFS= read -r opcao; do
		set -- "$@" -c "$opcao"
	done <<-OPCOES
	$("$HIVE_NODE" "$HIVE_ROOT/sidebar/codex.js")
	OPCOES
	codex=$(command -v codex)
	case $codex in /*) ;; *) codex= ;; esac
	if [ -z "$codex" ]; then
		echo "Codex não encontrado no PATH." >&2
		status=127
	else
		"$codex" --no-daemon -c 'tui.terminal_title=["thread-name"]' "$@"
		status=$?
	fi
else
	"$HIVE_CLAUDE" --settings "$HIVE_ROOT/sidebar/hooks.json" "$@"
	status=$?
fi

# Erro ao abrir a IA: deixa a mensagem na tela antes de fechar.
if [ $status -ne 0 ]; then
	printf '\n%s saiu com status %s. Pressione Enter para fechar.' "$ia" "$status"
	read -r _
fi

# No modo gráfico, cada conversa tem sua sessão isolada. O servidor acompanha
# o encerramento e atualiza a seleção sem manipular os panes de outras sessões.
if [ "$HIVE_GUI" = 1 ]; then
	exit "$status"
fi

tmux set -pu -t "$TMUX_PANE" @conversa
outra=$(tmux list-panes -s -F '#{@conversa} #{pane_id}' | awk '$2 { print }' |
	sort -n | awk 'NR == 1 { print $2 }')
if [ -z "$outra" ]; then
	tmux kill-session
	exit $status
fi

# Estava na tela: a próxima conversa ocupa o lugar.
janela() { tmux display -p -t "$1" '#{window_id}'; }
if [ "$(janela "$TMUX_PANE")" = "$(janela "$(tmux show -qv @sidebar)")" ]; then
	tmux resize-window -t "$outra" \
		-x "$(tmux display -p -t "$TMUX_PANE" '#{pane_width}')" \
		-y "$(tmux display -p -t "$TMUX_PANE" '#{pane_height}')"
	tmux swap-pane -dZ -s "$outra" -t "$TMUX_PANE"
	tmux set -pu -t "$outra" @novo
	tmux select-pane -Z -t "$outra"
	kill -USR2 "$(tmux display -p -t "$(tmux show -qv @cabecalho)" '#{pane_pid}')" 2>/dev/null
fi
exit $status
