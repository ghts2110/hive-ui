#!/bin/sh
# O comando simples abre a janela do Hive. --terminal mantém a interface
# tmux; argumentos e subcomandos do Claude continuam compatíveis.

# Instalado pelo `npm link`, o `hive` do PATH é um link para este arquivo:
# segue os links até o repositório.
SELF=$0
while [ -L "$SELF" ]; do
	alvo=$(readlink "$SELF")
	case $alvo in
		/*) SELF=$alvo ;;
		*) SELF=$(dirname "$SELF")/$alvo ;;
	esac
done
ROOT=$(cd "$(dirname "$SELF")/.." && pwd -P)

# A interface gráfica é um aplicativo próprio, sem abrir o navegador.
if [ "$#" -eq 0 ] || [ "$1" = --gui ]; then
	[ "$#" -eq 0 ] || shift
	if [ "$#" -gt 0 ]; then
		echo "hive --gui: escolha o agente, o modelo e a pasta pela interface." >&2
		exit 1
	fi
	exec node "$ROOT/gui/desktop.js"
fi

[ "$1" != --terminal ] || shift

# Binário original, nunca a função antiga `claude()` do ~/.zshrc, que chama
# este launcher: só um caminho serve, senão seria uma função exportada (bash
# com `export -f`) e o exec entraria em recursão.
CLAUDE_BIN=$(command -v claude)
case $CLAUDE_BIN in /*) ;; *) CLAUDE_BIN= ;; esac
if [ -z "$CLAUDE_BIN" ]; then
	echo "hive: Claude Code não encontrado no PATH." >&2
	exit 127
fi

# Já dentro do hive-ui (ou de outro tmux), ou fora de um terminal
# (pipes, scripts): roda o claude puro.
if [ -n "$HIVE" ] || [ -n "$TMUX" ] || [ ! -t 0 ] || [ ! -t 1 ]; then
	exec "$CLAUDE_BIN" "$@"
fi

# Modos não interativos e subcomandos também: a saída deles sumiria com o tmux.
case $1 in
	agents | attach | auth | auto-mode | doctor | gateway | import | install | \
	logs | mcp | plugin | plugins | purge | respawn | rm | setup-token | stop | \
	kill | ultrareview | update | upgrade)
		exec "$CLAUDE_BIN" "$@" ;;
esac
for arg do
	case $arg in
		-p | --print | -v | --version | -h | --help) exec "$CLAUDE_BIN" "$@" ;;
	esac
done

if ! command -v tmux >/dev/null 2>&1; then
	echo "hive: tmux não encontrado. Instale com 'brew install tmux'" >&2
	echo "ou use 'claude' para abrir o Claude Code sem a interface." >&2
	exit 1
fi

NODE_BIN=$(command -v node)
if [ -z "$NODE_BIN" ]; then
	echo "hive: Node não encontrado. Instale o Node 22.12+" >&2
	echo "ou use 'claude' para abrir o Claude Code sem a interface." >&2
	exit 1
fi

if [ ! -d "$ROOT/node_modules/ink" ]; then
	echo "hive: dependências faltando. Rode 'npm install' em $ROOT" >&2
	exit 1
fi

# O tmux lê um argumento terminado em ';' como separador de comandos;
# escapa para ele chegar intacto ao claude.
for arg do
	shift
	case $arg in
		*\;) arg="${arg%;}\\;" ;;
	esac
	set -- "$@" "$arg"
done

# Enquanto a sessão estiver aberta, nem o Mac dorme nem a tela apaga por
# inatividade (-i e -d; fechar a tampa continua pondo para dormir). -w prende o
# caffeinate a este processo, que vira o cliente do tmux no exec e só sai
# quando a sessão acaba: terminal fechado ou crash também o soltam. Só no
# macOS: no Linux, o caffeinate do pacote caffeine tem outra sintaxe.
if [ "$(uname)" = Darwin ] && command -v caffeinate >/dev/null 2>&1; then
	caffeinate -di -w $$ </dev/null >/dev/null 2>&1 &
fi

# Um servidor tmux por terminal, para cada claude herdar o ambiente do
# terminal que o abriu. Sessão criada já anexada: com destroy-unattached, uma
# sessão em segundo plano morreria antes do attach. O sidebar é aberto de
# dentro do pane principal, para os argumentos do claude não passarem pelo
# parser do tmux.
exec tmux -L "${HIVE_SOCKET:-hive-$$}" -f "$ROOT/tmux.conf" \
	new-session -s hive \
	-e HIVE=1 -e HIVE_ROOT="$ROOT" -e HIVE_NODE="$NODE_BIN" \
	-e HIVE_CLAUDE="$CLAUDE_BIN" -e HIVE_IA=claude -e HIVE_MODELO= -- "$ROOT/bin/main-pane" "$@"
